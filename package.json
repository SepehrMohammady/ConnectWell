    "type": "git",
    "url": "git+https://github.com/SepehrMohammady/ConnectWell.git"
  },
  "bugs": {
    "url": "https://github.com/SepehrMohammady/ConnectWell/issues"
  },
  "homepage": "https://github.com/SepehrMohammady/ConnectWell#readme",
  "main": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.js",
    "test:i18n": "node test/i18n-check.js",
