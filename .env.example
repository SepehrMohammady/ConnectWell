# ConnectWell configuration.
#
# Copy to `.env` and edit. `.env` is gitignored — it is where everything about
# YOUR deployment lives, so nothing about it ever reaches the repository.
# Real environment variables override these.
#
# Every value below has a working default; the only one a real deployment must
# set is PUBLIC_ORIGIN.

# ---- where the app listens ----
# Keep HOST on loopback and put a reverse proxy in front of it for TLS.
PORT=3010
HOST=127.0.0.1

# URL prefix the app is served under. Empty serves it at the domain root.
BASE_PATH=/connectwell

# ---- production ----
# The origin your users actually type. It gates the allowed WebSocket origins
# and the Content-Security-Policy, so if this is wrong the page loads but
# realtime silently fails.
#PUBLIC_ORIGIN=https://chat.example.com

# Secure cookies and production behaviour. Set with a real HTTPS origin.
#PROD=1

# Your name, shown in the footer beside the copyright.
#BRAND=Example Org

# ---- storage ----
# Database and uploads. Back this directory up; nothing else holds state.
#DATA_DIR=data

#MAX_UPLOAD_MB=200
#PER_USER_FILE_MB=5120
#SESSION_DAYS=90

# How long a call rings unanswered before it is recorded as a missed call.
#CALL_RING_SECONDS=45

# ---- calls ----
#STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay, needed for calls to connect on CGNAT / mobile / strict
# NAT networks. Generate the secret on the server and never commit it:
#   printf 'TURN_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
# Then run: sudo bash deploy/setup-turn.sudo.sh
#TURN_HOST=chat.example.com
#TURN_SECRET=
#TURN_TTL=3600

# ---- shared-file retention ----
# Two independent rules over chat uploads only; profile and group photos are
# never eligible. DELETION IS OFF until PURGE_ENABLED=1 — until then every
# sweep is a dry run that only writes data/purge-log.jsonl. Read that log
# before switching it on.
#FILE_RETENTION_DAYS=365
#STORAGE_HIGH_GB=60
#STORAGE_LOW_GB=50
#STORAGE_MIN_AGE_MS=3600000
#STORAGE_SWEEP_MS=900000
#PURGE_ENABLED=1
