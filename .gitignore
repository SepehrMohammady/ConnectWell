apps/desktop/node_modules/
apps/desktop/dist/
apps/desktop/app-config.json
apps/android/.gradle/
apps/android/.kotlin/
apps/android/.idea/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
*.jks
*.keystore
